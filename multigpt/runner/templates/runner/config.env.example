# MultiGPT-Runner: persönliche Einstellungen für den systemd-User-Dienst.
# KEY=value, kein export; absolute Pfade verwenden (kein ~, $HOME oder %h).
# Werte überschreiben die Environment-Vorgaben in der Unit.
# Nach Änderungen: systemctl --user restart multigpt-runner
# Vorhandene Datei bleibt bei erneuter Kopplung erhalten.

# Web-Ausgabe: ohne EXPOSE_HOST wird die Adresse automatisch ermittelt.
# MGPT_EXPOSE_HOST=192.168.24.127
# MGPT_EXPOSE_BIND=0.0.0.0

# Verbindung, Zertifikat und Arbeits-Images (nur mit Digest).
# MGPT_URL=https://mgpt.example
# MGPT_CA_SHA256=<64 Hex-Zeichen>
# MGPT_IMAGES="ghcr.io/beerlesklopfer/multigpt-runner-work@sha256:<Digest>"
# MGPT_HOSTNAME=WS-Joerg

# Absolute Pfade, passend zum Benutzer und Rechner.
# MGPT_TOKEN_FILE=/home/joerg/.config/multigpt-runner/token
# MGPT_SERVER_KEY_FILE=/home/joerg/.config/multigpt-runner/server.pub
# MGPT_PODMAN_SOCKET=/run/user/1000/podman/podman.sock
# MGPT_SCRATCH_DIR=/home/joerg/MultiGPT/Scratch
# MGPT_SCRATCH_HOST_DIR=/home/joerg/MultiGPT/Scratch

# Optionaler Dienstkatalog statt des eingebauten.
# MGPT_CATALOG_FILE=/absolute/path/catalog.json
# MGPT_CATALOG_SIG_FILE=/absolute/path/catalog.sig
# MGPT_CATALOG_KEY=<16 Hex-Zeichen>

# Entwicklung: unverschlüsselte WebSockets ausdrücklich erlauben.
# MGPT_INSECURE_DEV=1
# MGPT_ENGINE=podman
# MGPT_LABELS="multigpt.test=1"
