{% autoescape off %}# MultiGPT-Runner als systemd-User-Dienst (natives Programm, Linux amd64/arm64).
# Ablage: ~/.config/systemd/user/multigpt-runner.service
# "multigpt-runner pair" legt diese Datei selbst an; von Hand danach:
#   systemctl --user daemon-reload && systemctl --user enable --now multigpt-runner
#
# Der Runner verbindet sich nur ausgehend mit {{ mgpt_url }} (wss, /runner/ws)
# und startet Arbeitscontainer über den Podman-Socket des Nutzers nur aus dem
# Image unten (mit Digest), nach fester Vorlage. Token und öffentlicher
# Schlüssel des Servers liegen in ~/.config/multigpt-runner/ (token 0600,
# server.pub schreibgeschützt), nie in dieser Datei oder im Container.

[Unit]
Description=MultiGPT-Runner
Wants=network-online.target podman.socket
After=network-online.target podman.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/multigpt-runner
Environment=MGPT_URL={{ mgpt_url }}
{% if ca_sha256 %}# Selbstsigniertes Zertifikat des Servers: SHA-256-Fingerprint festgehalten.
Environment=MGPT_CA_SHA256={{ ca_sha256 }}
{% endif %}Environment=MGPT_TOKEN_FILE=%h/.config/multigpt-runner/token
Environment=MGPT_SERVER_KEY_FILE=%h/.config/multigpt-runner/server.pub
Environment=MGPT_PODMAN_SOCKET=%t/podman/podman.sock
# Positivliste: nur dieses Arbeits-Image (mit Digest) wird gestartet.
Environment=MGPT_IMAGES={{ work_image }}
# Lokales Scratchpad (Arbeitsstand mit Ablage „lokal“): je Arbeitsstand ein
# Ordner <UUID> darin, im Container als /scratch (noexec, nosuid, nodev).
Environment=MGPT_SCRATCH_DIR=%h/MultiGPT/Scratch
Environment=MGPT_SCRATCH_HOST_DIR=%h/MultiGPT/Scratch
ExecStartPre=/usr/bin/mkdir -p %h/MultiGPT/Scratch
NoNewPrivileges=true
Restart=on-failure
RestartSec=10
# 2: Einstellungen fehlen bzw. falsch; 3: Token ungültig oder widerrufen, Recht
# fehlt, ersetzt, Version passt nicht oder Signatur des Servers ungültig
# (Close 4401/4403/4409/4426/4498) – dann nicht neu starten, sondern neu koppeln.
RestartPreventExitStatus=2 3

[Install]
WantedBy=default.target
{% endautoescape %}
