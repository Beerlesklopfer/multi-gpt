# MultiGPT – Konfiguration für die Entwicklung.
#
# `make install` kopiert diese Datei nach .env (Rechte 600) und ersetzt die
# Platzhalter __SECRET_KEY__ und __FIELD_ENCRYPTION_KEY__ durch frisch
# generierte Werte. Eine vorhandene .env wird nie überschrieben.
# Im Betrieb (Debian-Paket) liegt die Datei unter /etc/multi-gpt/.env.
# Bereits gesetzte Umgebungsvariablen haben Vorrang vor dieser Datei.

# --- Django ------------------------------------------------------------------

# Geheimer Schlüssel für Sessions, CSRF usw. Niemals weitergeben.
SECRET_KEY=__SECRET_KEY__

# Nur in der Entwicklung True. Steuert auch, ob WhiteNoise mit Manifest arbeitet.
DEBUG=True

# Kommagetrennt. Hostnamen bzw. Origins (mit Schema), unter denen die App erreichbar ist.
# Der Health-Check /healthz/ braucht hier keinen Eintrag (er prüft den Host nicht).
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://multigpt.example.lan

# Schlüssel für die Verschlüsselung der API-Keys (Fernet: urlsafe-base64, 32 Bytes).
# Ab Meilenstein 2 in Gebrauch. Geht er verloren, sind gespeicherte Keys unlesbar.
FIELD_ENCRYPTION_KEY=__FIELD_ENCRYPTION_KEY__

# --- Datenbank (PostgreSQL mit pgvector) --------------------------------------

# Entwicklung: Unix-Socket mit Peer-Auth, Rolle = eigener Systemnutzer
# (angelegt mit `make db-create`).
DATABASE_URL=postgres:///multigpt
# Docker-Weg (compose.yaml, Dienst db, Nutzer/DB "multi-gpt"):
# DATABASE_URL=postgres://multi-gpt:PASSWORT@localhost:5432/multi-gpt

# Lebensdauer einer DB-Verbindung in Sekunden (0 = je Anfrage neu).
# DB_CONN_MAX_AGE=60
# Vorlage für die Test-DB (UTF-8 mit pgvector, angelegt von make db-create)
DB_TEST_TEMPLATE=multigpt_template

# Passwort des Datenbanknutzers im Docker-Weg (compose.yaml, Dienst db).
# URL-sicher wählen, z. B. `openssl rand -hex 24`. Für die Entwicklung mit
# lokalem PostgreSQL nicht nötig.
# POSTGRES_PASSWORD=
# Port, auf dem compose die DB an 127.0.0.1 veröffentlicht (Standard 5432;
# ändern, wenn lokal schon ein PostgreSQL läuft).
# POSTGRES_PORT=5432

# --- Dateien -----------------------------------------------------------------

# Ziel von `make static` (collectstatic). Standard: ./staticfiles
# STATIC_ROOT=/pfad/zu/staticfiles

# Hochgeladene und erzeugte Dateien. Standard: ./media
# MEDIA_ROOT=/pfad/zu/media

# --- Sicherheit ----------------------------------------------------------------

# Erst auf True setzen, wenn TLS (nginx) davor steht: Secure-Cookies und
# Auswertung von X-Forwarded-Proto.
SECURE_COOKIES=False

# Login-Drosselung (django-axes): Sperre nach so vielen Fehlversuchen je
# Nutzername und IP, für AXES_COOLOFF_HOURS Stunden.
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_HOURS=0.25
# Anzahl vorgeschalteter Reverse-Proxys (nginx = 1), damit die echte IP zählt
# (letzter bzw. n-letzter Eintrag in X-Forwarded-For).
# AXES_PROXY_COUNT=0
# Downloads hochgeladener Dokumente über nginx (X-Accel-Redirect) ausliefern.
# Nur mit nginx davor und Leserecht des nginx-Nutzers auf MEDIA_ROOT.
# USE_X_ACCEL_REDIRECT=False

# --- Dokumente (RAG) ---------------------------------------------------------

# Höchstgröße eines hochgeladenen Dokuments in MB (nginx: client_max_body_size
# mindestens genauso groß wählen; das Debian-Paket setzt Wert + 10 MB, nach
# einer Änderung: dpkg-reconfigure multi-gpt).
# DOCUMENT_MAX_UPLOAD_MB=25
# Sprachen der Texterkennung für gescannte PDF-Seiten (Tesseract-Sprachpakete,
# z. B. tesseract-ocr-deu); mehrere mit "+" verbinden.
# OCR_LANGUAGES=deu+eng
# Versuche je Hintergrundjob (Indexierung), danach gilt er als fehlgeschlagen.
# JOB_MAX_ATTEMPTS=5
# Verzeichnisquellen: Wurzeln auf dem Server/NAS, aus denen Verwalter Sammlungen
# periodisch einlesen lassen dürfen (Komma-Liste absoluter Pfade, leer = aus).
# Die Dateien bleiben am Ort und werden nur gelesen. Der Dienstnutzer
# multi-gpt braucht Leserechte (z. B. über eine Gruppe); Pfade unter /home sind
# im Paket wegen ProtectHome=yes gesperrt -> Drop-in, siehe Unit-Dateien.
# RAG_SOURCE_ROOTS=/srv/nas/dokumente,/srv/nas/archiv
# Höchstzahl Dateien je Einlesevorgang (der Rest folgt im nächsten Lauf).
# RAG_SOURCE_MAX_FILES=5000

# --- MCP-Server und API-Keys (Knoten) -------------------------------------------

# MultiGPT ist unter /mcp/ selbst MCP-Server (n8n, Claude Desktop, Agenten), mit
# API-Keys je Konto (Einstellungen -> API-Keys). Ungültige Keys je IP, ab denen
# /mcp/ für diese IP gesperrt ist (Minuten), und Aufrufe je Key und Minute.
# API_FAILURE_LIMIT=10
# API_FAILURE_WINDOW_MINUTES=15
# API_RATE_LIMIT_PER_MINUTE=120
# Höchstgröße einer Datei für get_file in MB; Aufbewahrung des Audit-Logs in Tagen.
# API_FILE_MAX_MB=20
# API_AUDIT_DAYS=90

# --- Websuche ------------------------------------------------------------------

# Nur Entwicklung: Seitenabruf der Websuche auch von Intranet-Adressen erlauben
# (für Browsertests mit lokalem Testserver). Wirkt nur zusammen mit DEBUG=True.
# WEBSEARCH_ALLOW_PRIVATE=False

# --- Logging -----------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# --- Gunicorn (make run, Paket, Docker) ----------------------------------------
# Werden von deploy/gunicorn.conf.py gelesen (LOG_LEVEL gilt auch für gunicorn).
# Adresse:Port, auf der gunicorn lauscht.
# MULTI_GPT_BIND=127.0.0.1:8000
# Prozesse und Threads je Prozess (Worker-Klasse gthread).
# MULTI_GPT_WORKERS=2
# MULTI_GPT_THREADS=8
# Timeout in Sekunden; lang wegen gestreamter KI-Antworten.
# MULTI_GPT_TIMEOUT=300
