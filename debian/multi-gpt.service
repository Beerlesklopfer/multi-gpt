[Unit]
Description=MultiGPT (gunicorn)
# Nur Reihenfolge: die Datenbank kann auch auf einem anderen Rechner laufen.
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
# Gunicorn meldet sich per sd_notify (READY=1), sobald der Arbiter läuft.
Type=notify
User=multi-gpt
Group=multi-gpt
WorkingDirectory=/var/lib/multi-gpt
Environment=DJANGO_SETTINGS_MODULE=multigpt.settings
Environment=STATIC_ROOT=/usr/share/python/multi-gpt/static
EnvironmentFile=/etc/multi-gpt/.env
ExecStart=/usr/share/python/multi-gpt/bin/gunicorn --config /etc/multi-gpt/gunicorn.conf.py multigpt.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
# Länger als graceful_timeout (30 s) in gunicorn.conf.py.
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
UMask=0027

RuntimeDirectory=multi-gpt
StateDirectory=multi-gpt
StateDirectoryMode=0750
# Liegt MEDIA_ROOT außerhalb von /var/lib/multi-gpt (z. B. NAS-Freigabe),
# per Drop-in freigeben: systemctl edit multi-gpt -> ReadWritePaths=/pfad
#
# Verzeichnisquellen (RAG_SOURCE_ROOTS): Der Dienst liest dort nur. Wegen
# ProtectSystem=strict ist alles außer /var/lib/multi-gpt ohnehin schreibgeschützt;
# Pfade unter /srv, /mnt, /media sind lesbar, Pfade unter /home, /root und
# /run/user sind wegen ProtectHome=yes unsichtbar. Freigabe per Drop-in für BEIDE
# Units (Weboberfläche prüft den Pfad, der Worker liest die Dateien):
#   systemctl edit multi-gpt          (und ebenso: systemctl edit multi-gpt-worker)
#     [Service]
#     # Variante A: /home lesbar machen, aber nur lesend
#     ProtectHome=read-only
#     # Variante B (enger): nur ein Verzeichnis einblenden, Rest von /home bleibt leer
#     #ProtectHome=tmpfs
#     #BindReadOnlyPaths=/home/familie/Dokumente
#     # Pfade außerhalb von /home (z. B. NAS-Mount) zusätzlich schreibschützen:
#     #ReadOnlyPaths=/srv/nas/dokumente
#   systemctl restart multi-gpt multi-gpt-worker
# Leserechte: den Dienstnutzer in eine Gruppe mit r-x auf die Ordner und r auf
# die Dateien aufnehmen (usermod -aG <gruppe> multi-gpt) und neu starten.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# AF_NETLINK: bubblewrap richtet im neuen, leeren Netz-Namespace der Sandbox für
# Berechnungen (run_python, M4a-10) das Loopback-Gerät per NETLINK_ROUTE ein und
# bricht ohne diese Familie ab. Netlink wirkt dort nur im Namespace der Sandbox.
# User-Namespaces (bwrap --unshare-all) brauchen kein weiteres Recht: Die Unit
# setzt kein RestrictNamespaces=; NoNewPrivileges verträgt sich mit bwrap ohne
# setuid. Ein neues /proc in der Sandbox verbieten ProtectKernelTunables und
# ProtectKernelLogs – die Sandbox kommt deshalb ohne /proc aus.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
