#!/bin/sh
set -e

. /usr/share/debconf/confmodule

ENV_FILE=/etc/multi-gpt/.env
NGINX_GEN_DIR=/etc/multi-gpt/nginx
SNAKEOIL_CERT=/etc/ssl/certs/ssl-cert-snakeoil.pem

# Wert eines Schlüssels aus der bestehenden .env (leer, wenn nicht vorhanden).
env_value() {
    [ -r "$ENV_FILE" ] || return 0
    sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1
}

# Argumente einer nginx-Direktive aus einer vom postinst erzeugten Datei.
nginx_value() {
    [ -r "$NGINX_GEN_DIR/$1" ] || return 0
    sed -n "s/^[[:space:]]*$2[[:space:]]\{1,\}\([^;]*\);.*/\1/p" "$NGINX_GEN_DIR/$1" | head -n 1
}

# Wort an eine Leerzeichen-Liste anhängen, wenn es noch fehlt.
add_word() {
    case " $1 " in
        *" $2 "*) printf '%s' "$1" ;;
        *) printf '%s' "${1:+$1 }$2" ;;
    esac
}

# Vorhandene Konfiguration hat Vorrang: Die zuletzt erzeugte nginx-Konfiguration
# und Handänderungen an ALLOWED_HOSTS in der .env werden zum Vorschlag, damit
# eine erneute Abfrage (dpkg-reconfigure, Upgrade) sie nicht verwirft.

ips=$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]+(\.[0-9]+){3}$' | grep -v '^127\.' || true)
fqdn=$(hostname -f 2>/dev/null || true)
short=$(hostname 2>/dev/null || true)
short=${short%%.*}

names_default=""
for h in $fqdn $short; do
    case "$h" in localhost|localhost.*|"") continue ;; esac
    names_default=$(add_word "$names_default" "$h")
done
[ -n "$names_default" ] || names_default=localhost

# Basis: zuletzt erzeugte nginx-Konfiguration, sonst ein vorbelegter
# debconf-Wert, sonst der Hostname des Rechners.
db_get multi-gpt/server_name || RET=""
names=$(nginx_value http.conf server_name)
[ "$names" != "_" ] || names=""
[ -n "$names" ] || names=$RET
[ -n "$names" ] || names=$names_default

# Zusätzliche Namen, die von Hand in ALLOWED_HOSTS eingetragen wurden (ohne
# localhost und die aktuellen Adressen dieses Rechners, die ohnehin dazukommen).
set -f  # "*" in ALLOWED_HOSTS nicht als Dateimuster erweitern
for h in $(env_value ALLOWED_HOSTS | tr ',' ' '); do
    case "$h" in localhost|127.0.0.1|::1|"[::1]"|"*") continue ;; esac
    case " $(echo $ips) " in *" $h "*) continue ;; esac
    # ".example.org" stammt aus dem server_name "*.example.org"
    case " $names " in *" *$h "*) continue ;; esac
    names=$(add_word "$names" "$h")
done
set +f
db_set multi-gpt/server_name "$names"

if [ -r "$NGINX_GEN_DIR/https.conf" ]; then
    cert=$(nginx_value https.conf ssl_certificate)
    key=$(nginx_value https.conf ssl_certificate_key)
    if [ "$cert" = "$SNAKEOIL_CERT" ]; then
        cert="" key=""
    fi
    db_set multi-gpt/tls_certificate "$cert"
    db_set multi-gpt/tls_key "$key"
fi

db_input high multi-gpt/server_name || true
db_input high multi-gpt/tls_certificate || true
db_go || true

# Der Schlüssel wird nur zu einem eigenen Zertifikat gefragt.
db_get multi-gpt/tls_certificate || RET=""
if [ -n "$RET" ]; then
    db_input high multi-gpt/tls_key || true
    db_go || true
fi
