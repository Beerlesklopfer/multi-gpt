#!/bin/sh
set -e

. /usr/share/debconf/confmodule

ENV_FILE=/etc/multi-gpt/.env

# Wert eines Schlüssels aus der bestehenden .env (leer, wenn nicht vorhanden).
env_value() {
    [ -r "$ENV_FILE" ] || return 0
    sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1
}

# Vorhandene Konfiguration hat Vorrang: Handänderungen in der .env werden zum
# Vorschlag, damit eine erneute Abfrage (dpkg-reconfigure, Upgrade) sie nicht
# überschreibt.
preseed() {
    _key=$1 _question=$2 _default=$3
    _current=$(env_value "$_key")
    db_get "$_question"
    if [ -n "$_current" ]; then
        db_set "$_question" "$_current"
    elif [ -z "$RET" ]; then
        db_set "$_question" "$_default"
    fi
}

# Erste IPv4-Adresse des Rechners (nicht loopback) als Vorschlag.
ip=$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]+(\.[0-9]+){3}$' | head -n 1 || true)
fqdn=$(hostname -f 2>/dev/null || hostname 2>/dev/null || true)

bind_default=127.0.0.1:8000
[ -z "$ip" ] || bind_default="$ip:8000"

hosts_default=localhost,127.0.0.1
for h in $ip $fqdn; do
    case ",$hosts_default," in
        *",$h,"*) ;;
        *) hosts_default="$hosts_default,$h" ;;
    esac
done

origin_default=""
[ -z "$ip" ] || origin_default="http://$ip:8000"

preseed MULTI_GPT_BIND multi-gpt/bind_address "$bind_default"
preseed ALLOWED_HOSTS multi-gpt/allowed_hosts "$hosts_default"
preseed CSRF_TRUSTED_ORIGINS multi-gpt/public_url "$origin_default"

db_input high multi-gpt/bind_address || true
db_input high multi-gpt/allowed_hosts || true
db_input medium multi-gpt/public_url || true
db_go || true
