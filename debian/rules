#!/usr/bin/make -f

export DH_VIRTUALENV_INSTALL_ROOT = /usr/share/python

# Das venv wird fest gegen die versionierte Interpreter-Binary gebaut
# (bin/python -> /usr/bin/python3.X). Das Paket hängt über ${venv:Depends}
# genau von dieser Version ab, damit ein Wechsel von /usr/bin/python3 auf eine
# neue Minor-Version das venv (lib/python3.X/site-packages) nicht zerbricht.
PY_VERSION := $(shell python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
PYTHON := /usr/bin/python$(PY_VERSION)

VENV_BUILD := $(CURDIR)/debian/multi-gpt$(DH_VIRTUALENV_INSTALL_ROOT)/multi-gpt

%:
	dh $@ --with python-virtualenv

# Nach dem Bau des venv: statische Dateien ins Paket sammeln
# (WhiteNoise, Manifest-Storage, STATIC_ROOT im Paket).
# -I: Quellbaum (cwd) und PYTHON*-Variablen ignorieren, damit das frisch
#     installierte Paket aus dem venv importiert wird – so fällt fehlende
#     package-data (Templates/Static) schon beim Bauen auf.
# -B: keine zusätzlichen .pyc-Dateien schreiben.
# MULTI_GPT_ENV_FILE=/dev/null: keine .env aus dem Quellbaum lesen.
# Die DATABASE_URL ist ein Platzhalter, collectstatic verbindet sich nicht.
override_dh_virtualenv:
	dh_virtualenv --python $(PYTHON) --builtin-venv --upgrade-pip
	env DJANGO_SETTINGS_MODULE=multigpt.settings \
	    MULTI_GPT_ENV_FILE=/dev/null \
	    SECRET_KEY=build-only-not-secret \
	    DATABASE_URL=postgres://build/build \
	    DEBUG=False \
	    STATIC_ROOT=$(VENV_BUILD)/static \
	    $(VENV_BUILD)/bin/python -I -B -m django collectstatic --noinput --verbosity 1
	echo "venv:Depends=python$(PY_VERSION)" >> debian/multi-gpt.substvars

# Die Tests brauchen eine laufende PostgreSQL-Datenbank und laufen deshalb
# nicht im Paketbau, sondern über `make test`. (Die Sequenz python-virtualenv
# entfernt dh_auto_test ohnehin; der Override hält das ausdrücklich fest.)
override_dh_auto_test:

# Binär-Wheels (z. B. psycopg-binary) bringen eigene, mit patchelf
# angepasste Bibliotheken mit. Strippen kann diese beschädigen, und für die
# gebündelten Bibliotheken gibt es keine shlibs-Information.
# Die Runner-Binaries (M14, /usr/share/multi-gpt/runner/) sind fertig gebaut,
# statisch (musl) und zum Teil für arm64: unverändert lassen, sonst passen
# SHA256SUMS und Signatur nicht mehr.
RUNNER_DIST := /usr/share/multi-gpt/runner/

override_dh_strip:
	dh_strip --exclude=/site-packages/ --exclude=$(RUNNER_DIST)

override_dh_dwz:
	dh_dwz --exclude=/site-packages/ --exclude=$(RUNNER_DIST)

override_dh_shlibdeps:
	dh_shlibdeps --exclude=/site-packages/ --exclude=$(RUNNER_DIST)

# Drei Units: Weboberfläche (debian/multi-gpt.service), Worker für die
# Indexierung (debian/multi-gpt.multi-gpt-worker.service, M7) und Runner-Dienst
# (debian/multi-gpt.multi-gpt-runner.service, M14: WebSocket /runner/ws).
# Jeweils mit --name, damit jeder Aufruf genau seine Unit behandelt (ohne
# --name würden spätere Aufrufe alle Units erneut einbinden). Alle werden bei
# Installation aktiviert und gestartet, beim Upgrade nach der Migration im
# postinst neu gestartet (compat 13: --restart-after-upgrade).
override_dh_installsystemd:
	dh_installsystemd --name=multi-gpt
	dh_installsystemd --name=multi-gpt-worker
	dh_installsystemd --name=multi-gpt-runner

# Digests der Runner-Images (M14-13): Beim Tag legt die CI (package.yml, aus
# images.yml) debian/runner-images.env an; Django liest daraus die Standardwerte
# von RUNNER_AGENT_IMAGE und RUNNER_WORK_IMAGE (/etc/multi-gpt/.env geht vor).
# Lokal (make deb, Docker) fehlt die Datei, dann gelten die Tags aus settings.py.
#
# Runner-Binaries (M14): Beim Tag legt die CI (package.yml, Job runner-dist,
# scripts/runner-release.sh) debian/runner-dist/ an – multigpt-runner-linux-
# {amd64,arm64}, catalog.json(.sig), SHA256SUMS(.sig), release_keys.json. Sie
# landen in RUNNER_DIST_DIR (/usr/share/multi-gpt/runner/), aus dem
# /runner/download/<arch> liefert; nur zum Herunterladen, deshalb 0644.
# Lokal (make deb) fehlt der Ordner; `make runner-dist` legt ihn mit
# Wegwerf-Schlüssel an (dist/runner/, von Hand nach debian/runner-dist/ kopieren).
execute_after_dh_install:
	if [ -f debian/runner-images.env ]; then \
	    install -D -m 0644 debian/runner-images.env \
	        debian/multi-gpt/usr/share/multi-gpt/runner-images.env; \
	fi
	if [ -d debian/runner-dist ]; then \
	    (cd debian/runner-dist && sha256sum --check --strict --quiet SHA256SUMS) && \
	    install -d -m 0755 debian/multi-gpt$(RUNNER_DIST) && \
	    install -m 0644 debian/runner-dist/multigpt-runner-linux-* \
	        debian/runner-dist/catalog.json debian/runner-dist/catalog.json.sig \
	        debian/runner-dist/SHA256SUMS debian/runner-dist/SHA256SUMS.sig \
	        debian/runner-dist/release_keys.json \
	        debian/multi-gpt$(RUNNER_DIST); \
	fi

# dh_auto_clean ist durch die Sequenz entfernt; Reste des Wheel-Builds
# (setuptools baut im Quellbaum) selbst wegräumen.
execute_after_dh_clean:
	rm -rf build
